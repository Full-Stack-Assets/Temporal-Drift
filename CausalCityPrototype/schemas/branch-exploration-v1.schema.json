{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ripple-city.invalid/schemas/branch-exploration-v1.schema.json",
  "title":"Ripple Branch Exploration v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","schemaVersion","approximation","executionAuthority","reviewRequired","parentRef","evaluator","seedState","terminalPrngState","axes","objectives","config","candidates","generations","paretoFrontier","proposals","explorationHash"],
  "properties":{
    "format":{"const":"ripple-branch-exploration"},
    "schemaVersion":{"const":"1.0.0"},
    "approximation":{"const":true},
    "executionAuthority":{"const":"none"},
    "reviewRequired":{"const":true},
    "parentRef":{"$ref":"#/$defs/parentRef"},
    "evaluator":{"$ref":"#/$defs/evaluator"},
    "seedState":{"$ref":"#/$defs/prng"},
    "terminalPrngState":{"$ref":"#/$defs/prng"},
    "axes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/axis"}},
    "objectives":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/objective"}},
    "config":{"$ref":"#/$defs/config"},
    "candidates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidate"}},
    "generations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/generation"}},
    "paretoFrontier":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidateId"}},
    "proposals":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/proposal"}},
    "explorationHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "graphId":{"type":"string","pattern":"^graph-[a-f0-9]{64}$"},
    "branchId":{"type":"string","pattern":"^branch-[a-f0-9]{64}$"},
    "candidateId":{"type":"string","pattern":"^candidate-[a-f0-9]{64}$"},
    "nonEmpty":{"type":"string","minLength":1},
    "safeInteger":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
    "nonNegative":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "positive":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "integerMap":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/safeInteger"}},
    "parentRef":{"type":"object","additionalProperties":false,"required":["graphId","parentBranchId","forkStepId","parentReceiptHash"],"properties":{"graphId":{"$ref":"#/$defs/graphId"},"parentBranchId":{"$ref":"#/$defs/branchId"},"forkStepId":{"$ref":"#/$defs/nonEmpty"},"parentReceiptHash":{"$ref":"#/$defs/hash"}}},
    "evaluator":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"$ref":"#/$defs/nonEmpty"},"version":{"$ref":"#/$defs/nonEmpty"}}},
    "prng":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":0,"maximum":4294967295}},
    "axis":{"type":"object","additionalProperties":false,"required":["axisId","minimum","maximum","step"],"properties":{"axisId":{"$ref":"#/$defs/nonEmpty"},"minimum":{"$ref":"#/$defs/safeInteger"},"maximum":{"$ref":"#/$defs/safeInteger"},"step":{"$ref":"#/$defs/positive"}}},
    "objective":{"type":"object","additionalProperties":false,"required":["metricId","direction","weight"],"properties":{"metricId":{"$ref":"#/$defs/nonEmpty"},"direction":{"enum":["maximize","minimize"]},"weight":{"$ref":"#/$defs/positive"}}},
    "config":{"type":"object","additionalProperties":false,"required":["populationLimit","survivorCount","generations","proposalLimit"],"properties":{"populationLimit":{"$ref":"#/$defs/positive"},"survivorCount":{"$ref":"#/$defs/positive"},"generations":{"$ref":"#/$defs/nonNegative"},"proposalLimit":{"$ref":"#/$defs/positive"}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["parameters","metrics","score","candidateId"],"properties":{"parameters":{"$ref":"#/$defs/integerMap"},"metrics":{"$ref":"#/$defs/integerMap"},"score":{"$ref":"#/$defs/safeInteger"},"candidateId":{"$ref":"#/$defs/candidateId"}}},
    "mutation":{"type":"object","additionalProperties":false,"required":["generation","parentCandidateId","candidateId","mutationId"],"properties":{"generation":{"$ref":"#/$defs/positive"},"parentCandidateId":{"$ref":"#/$defs/candidateId"},"candidateId":{"$ref":"#/$defs/candidateId"},"mutationId":{"type":"string","pattern":"^mutation-[a-f0-9]{64}$"}}},
    "generation":{"type":"object","additionalProperties":false,"required":["generation","populationCandidateIds","survivorCandidateIds","mutations","generationId"],"properties":{"generation":{"$ref":"#/$defs/nonNegative"},"populationCandidateIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidateId"}},"survivorCandidateIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidateId"}},"mutations":{"type":"array","items":{"$ref":"#/$defs/mutation"}},"generationId":{"type":"string","pattern":"^generation-[a-f0-9]{64}$"}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["candidateId","parentRef","parameters","metrics","score","status","reviewRequired","executionAuthority","proposalId"],"properties":{"candidateId":{"$ref":"#/$defs/candidateId"},"parentRef":{"$ref":"#/$defs/parentRef"},"parameters":{"$ref":"#/$defs/integerMap"},"metrics":{"$ref":"#/$defs/integerMap"},"score":{"$ref":"#/$defs/safeInteger"},"status":{"const":"proposed-for-human-review"},"reviewRequired":{"const":true},"executionAuthority":{"const":"none"},"proposalId":{"type":"string","pattern":"^branch-proposal-[a-f0-9]{64}$"}}}
  }
}