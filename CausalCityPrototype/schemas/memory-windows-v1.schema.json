{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ripple-city.invalid/schemas/memory-windows-v1.schema.json",
  "title":"Ripple Memory Windows v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","schemaVersion","approximation","currentSequence","windows","records","groups","memoryArtifactHash"],
  "properties":{
    "format":{"const":"ripple-memory-windows"},
    "schemaVersion":{"const":"1.0.0"},
    "approximation":{"const":true},
    "currentSequence":{"$ref":"#/$defs/nonNegative"},
    "windows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/window"}},
    "records":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}},
    "groups":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/group"}},
    "memoryArtifactHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "branchId":{"type":"string","pattern":"^branch-[a-f0-9]{64}$"},
    "recordId":{"type":"string","pattern":"^memory-record-[a-f0-9]{64}$"},
    "nonEmpty":{"type":"string","minLength":1},
    "safeInteger":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},
    "nonNegative":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "positive":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "nullablePerspective":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/nonEmpty"}]},
    "window":{"type":"object","additionalProperties":false,"required":["windowId","length"],"properties":{"windowId":{"$ref":"#/$defs/nonEmpty"},"length":{"$ref":"#/$defs/positive"}}},
    "record":{"type":"object","additionalProperties":false,"required":["perspectiveId","branchId","sequence","stepId","metricPath","objectiveValue","perceivedValue","scale","sourceRef","sourceVersion","memoryKind","generation","inheritedFromPerspectiveId","tension","magnitude","direction","memoryRecordId"],"properties":{"perspectiveId":{"$ref":"#/$defs/nonEmpty"},"branchId":{"$ref":"#/$defs/branchId"},"sequence":{"$ref":"#/$defs/nonNegative"},"stepId":{"$ref":"#/$defs/nonEmpty"},"metricPath":{"$ref":"#/$defs/nonEmpty"},"objectiveValue":{"$ref":"#/$defs/safeInteger"},"perceivedValue":{"$ref":"#/$defs/safeInteger"},"scale":{"$ref":"#/$defs/positive"},"sourceRef":{"$ref":"#/$defs/nonEmpty"},"sourceVersion":{"$ref":"#/$defs/nonEmpty"},"memoryKind":{"enum":["personal","cultural","institutional"]},"generation":{"$ref":"#/$defs/nonNegative"},"inheritedFromPerspectiveId":{"$ref":"#/$defs/nullablePerspective"},"tension":{"$ref":"#/$defs/safeInteger"},"magnitude":{"$ref":"#/$defs/nonNegative"},"direction":{"enum":["positive","negative","aligned"]},"memoryRecordId":{"$ref":"#/$defs/recordId"}}},
    "directionCounts":{"type":"object","additionalProperties":false,"required":["aligned","negative","positive"],"properties":{"aligned":{"$ref":"#/$defs/nonNegative"},"negative":{"$ref":"#/$defs/nonNegative"},"positive":{"$ref":"#/$defs/nonNegative"}}},
    "group":{"type":"object","additionalProperties":false,"required":["perspectiveId","branchId","metricPath","windowId","windowLength","currentSequence","status","recordIds","recordCount","totalWeight","weightedTensionNumerator","directionCounts","memoryWindowGroupId"],"properties":{"perspectiveId":{"$ref":"#/$defs/nonEmpty"},"branchId":{"$ref":"#/$defs/branchId"},"metricPath":{"$ref":"#/$defs/nonEmpty"},"windowId":{"$ref":"#/$defs/nonEmpty"},"windowLength":{"$ref":"#/$defs/positive"},"currentSequence":{"$ref":"#/$defs/nonNegative"},"status":{"enum":["modeled-from-explicit-records","not-modeled-in-window"]},"recordIds":{"type":"array","items":{"$ref":"#/$defs/recordId"}},"recordCount":{"$ref":"#/$defs/nonNegative"},"totalWeight":{"$ref":"#/$defs/nonNegative"},"weightedTensionNumerator":{"$ref":"#/$defs/safeInteger"},"directionCounts":{"$ref":"#/$defs/directionCounts"},"memoryWindowGroupId":{"type":"string","pattern":"^memory-window-group-[a-f0-9]{64}$"}}}
  }
}