{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ripple-city.invalid/schemas/trustscape-chunk-plan-v1.schema.json",
  "title":"Ripple Trustscape Chunk Plan v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","schemaVersion","canonical","sourceProjectionId","sourceProjectionHash","sourceTemporalPointCount","maxTemporalPointsPerChunk","chunks","chunkPlanHash"],
  "properties":{
    "format":{"const":"ripple-trustscape-chunk-plan"},
    "schemaVersion":{"const":"1.0.0"},
    "canonical":{"const":true},
    "sourceProjectionId":{"type":"string","pattern":"^projection-[a-f0-9]{64}$"},
    "sourceProjectionHash":{"$ref":"#/$defs/hash"},
    "sourceTemporalPointCount":{"$ref":"#/$defs/positive"},
    "maxTemporalPointsPerChunk":{"$ref":"#/$defs/positive"},
    "chunks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/chunk"}},
    "chunkPlanHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "branchId":{"type":"string","pattern":"^branch-[a-f0-9]{64}$"},
    "temporalId":{"type":"string","pattern":"^temporal-[a-f0-9]{64}$"},
    "nonNegative":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "positive":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "nullableHash":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/hash"}]},
    "chunk":{"type":"object","additionalProperties":false,"required":["branchId","startSequence","endSequence","temporalPointIds","receiptHashes","firstPreviousReceiptHash","terminalReceiptHash","pointCount","chunkId"],"properties":{"branchId":{"$ref":"#/$defs/branchId"},"startSequence":{"$ref":"#/$defs/nonNegative"},"endSequence":{"$ref":"#/$defs/nonNegative"},"temporalPointIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/temporalId"}},"receiptHashes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/hash"}},"firstPreviousReceiptHash":{"$ref":"#/$defs/nullableHash"},"terminalReceiptHash":{"$ref":"#/$defs/hash"},"pointCount":{"$ref":"#/$defs/positive"},"chunkId":{"type":"string","pattern":"^trustscape-chunk-[a-f0-9]{64}$"}}}
  }
}