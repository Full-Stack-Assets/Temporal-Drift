{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-stack-assets.example/schemas/offline-verification-capsule-v1.schema.json",
  "title": "Offline Verification Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "capsuleLabel",
    "artifactType",
    "artifactId",
    "artifactEncoding",
    "artifactCanonicalJson",
    "artifactByteLength",
    "artifactHash",
    "cryptoProfile",
    "schemaBundle",
    "schemaBundleHash",
    "keyRegistry",
    "meshPolicy",
    "attestations",
    "expectedRegistryAwareBundle",
    "claimBoundary",
    "capsuleHash",
    "capsuleId"
  ],
  "properties": {
    "format": { "const": "offline-verification-capsule" },
    "schemaVersion": { "const": "1.0.0" },
    "capsuleLabel": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactEncoding": { "const": "canonical-v1-json-utf8" },
    "artifactCanonicalJson": { "type": "string", "minLength": 1 },
    "artifactByteLength": { "type": "integer", "minimum": 1 },
    "artifactHash": { "$ref": "#/$defs/hash" },
    "cryptoProfile": { "$ref": "#/$defs/profile" },
    "schemaBundle": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/schemaEntry" }
    },
    "schemaBundleHash": { "$ref": "#/$defs/hash" },
    "keyRegistry": { "$ref": "#/$defs/keyRegistry" },
    "meshPolicy": { "$ref": "#/$defs/policy" },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attestation" }
    },
    "expectedRegistryAwareBundle": { "$ref": "#/$defs/admissionBundle" },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" },
    "capsuleHash": { "$ref": "#/$defs/hash" },
    "capsuleId": { "type": "string", "pattern": "^offline-capsule-[a-f0-9]{64}$" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "profileId": { "type": "string", "pattern": "^crypto-profile-[a-f0-9]{64}$" },
    "base64url": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "profileName",
        "hashAlgorithm",
        "signatureAlgorithm",
        "publicKeyEncoding",
        "signatureEncoding",
        "postQuantumMode",
        "hybridSignatureRequired",
        "quantumResistanceClaimed",
        "profileId"
      ],
      "properties": {
        "format": { "const": "crypto-policy-profile" },
        "schemaVersion": { "const": "1.0.0" },
        "profileName": { "type": "string", "minLength": 1 },
        "hashAlgorithm": { "const": "sha256" },
        "signatureAlgorithm": { "const": "ed25519" },
        "publicKeyEncoding": { "const": "spki-der-base64url" },
        "signatureEncoding": { "const": "base64url" },
        "postQuantumMode": { "const": "not-implemented" },
        "hybridSignatureRequired": { "const": false },
        "quantumResistanceClaimed": { "const": false },
        "profileId": { "$ref": "#/$defs/profileId" }
      }
    },
    "schemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema"],
      "properties": {
        "name": {
          "enum": [
            "crypto-policy-profile-v1",
            "verification-attestation-v1",
            "verification-mesh-policy-v1",
            "verification-mesh-v1",
            "external-anchor-request-v1",
            "external-anchor-receipt-v1",
            "proof-statement-v1",
            "verification-key-registry-v1"
          ]
        },
        "schema": { "type": "object" }
      }
    },
    "keyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "registryId",
        "eventType",
        "sequence",
        "logicalTime",
        "verifierNodeId",
        "operatorId",
        "subjectPublicKey",
        "subjectKeyFingerprint",
        "predecessorKeyFingerprint",
        "reasonCode",
        "previousEventHash",
        "eventHash"
      ],
      "properties": {
        "format": { "const": "verification-key-event" },
        "schemaVersion": { "const": "1.0.0" },
        "registryId": { "type": "string", "pattern": "^key-registry-[a-f0-9]{64}$" },
        "eventType": { "enum": ["register", "rotate", "revoke"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "logicalTime": { "type": "integer", "minimum": 0 },
        "verifierNodeId": { "type": "string", "minLength": 1 },
        "operatorId": { "type": "string", "minLength": 1 },
        "subjectPublicKey": { "$ref": "#/$defs/base64url" },
        "subjectKeyFingerprint": { "$ref": "#/$defs/hash" },
        "predecessorKeyFingerprint": { "$ref": "#/$defs/nullableHash" },
        "reasonCode": { "type": "string", "pattern": "^KEY_[A-Z0-9_]+$" },
        "previousEventHash": { "$ref": "#/$defs/nullableHash" },
        "eventHash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": { "properties": { "eventType": { "const": "rotate" } }, "required": ["eventType"] },
          "then": { "properties": { "predecessorKeyFingerprint": { "$ref": "#/$defs/hash" } } },
          "else": { "properties": { "predecessorKeyFingerprint": { "type": "null" } } }
        }
      ]
    },
    "keyRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "networkId",
        "cryptoProfileId",
        "registryVersion",
        "registryId",
        "identityBasis",
        "identityVerified",
        "registryAuthority",
        "events",
        "registryHash"
      ],
      "properties": {
        "format": { "const": "verification-key-registry" },
        "schemaVersion": { "const": "1.0.0" },
        "networkId": { "type": "string", "minLength": 1 },
        "cryptoProfileId": { "$ref": "#/$defs/profileId" },
        "registryVersion": { "type": "string", "minLength": 1 },
        "registryId": { "type": "string", "pattern": "^key-registry-[a-f0-9]{64}$" },
        "identityBasis": { "const": "declared-node-and-operator" },
        "identityVerified": { "const": false },
        "registryAuthority": { "const": "none" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/keyEvent" } },
        "registryHash": { "$ref": "#/$defs/hash" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "networkId",
        "artifactType",
        "artifactHash",
        "cryptoProfileId",
        "minimumPassingAttestations",
        "minimumDistinctOperators",
        "allowedVerifierNodeIds",
        "allowedOperatorIds",
        "requireDistinctKeyFingerprints",
        "policyId"
      ],
      "properties": {
        "format": { "const": "verification-mesh-policy" },
        "schemaVersion": { "const": "1.0.0" },
        "networkId": { "type": "string", "minLength": 1 },
        "artifactType": { "type": "string", "minLength": 1 },
        "artifactHash": { "$ref": "#/$defs/hash" },
        "cryptoProfileId": { "$ref": "#/$defs/profileId" },
        "minimumPassingAttestations": { "type": "integer", "minimum": 1 },
        "minimumDistinctOperators": { "type": "integer", "minimum": 1 },
        "allowedVerifierNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowedOperatorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "requireDistinctKeyFingerprints": { "type": "boolean" },
        "policyId": { "type": "string", "pattern": "^mesh-policy-[a-f0-9]{64}$" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "artifactType",
        "artifactId",
        "artifactHash",
        "verifierNodeId",
        "operatorId",
        "verificationMethod",
        "verificationVersion",
        "verifiedAtLogical",
        "runtime",
        "evidenceHash",
        "result",
        "failureCodes",
        "cryptoProfileId",
        "independenceStatus",
        "executionAuthority",
        "statementHash",
        "publicKeyEncoding",
        "publicKey",
        "publicKeyFingerprint",
        "signatureAlgorithm",
        "signatureEncoding",
        "signature",
        "attestationId"
      ],
      "properties": {
        "format": { "const": "verification-attestation" },
        "schemaVersion": { "const": "1.0.0" },
        "artifactType": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactHash": { "$ref": "#/$defs/hash" },
        "verifierNodeId": { "type": "string", "minLength": 1 },
        "operatorId": { "type": "string", "minLength": 1 },
        "verificationMethod": { "type": "string", "minLength": 1 },
        "verificationVersion": { "type": "string", "minLength": 1 },
        "verifiedAtLogical": { "type": "integer", "minimum": 0 },
        "runtime": { "type": "string", "minLength": 1 },
        "evidenceHash": { "$ref": "#/$defs/hash" },
        "result": { "enum": ["pass", "fail"] },
        "failureCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" } },
        "cryptoProfileId": { "$ref": "#/$defs/profileId" },
        "independenceStatus": { "const": "declared-not-proven" },
        "executionAuthority": { "const": "none" },
        "statementHash": { "$ref": "#/$defs/hash" },
        "publicKeyEncoding": { "const": "spki-der-base64url" },
        "publicKey": { "$ref": "#/$defs/base64url" },
        "publicKeyFingerprint": { "$ref": "#/$defs/hash" },
        "signatureAlgorithm": { "const": "ed25519" },
        "signatureEncoding": { "const": "base64url" },
        "signature": { "$ref": "#/$defs/base64url" },
        "attestationId": { "type": "string", "pattern": "^attestation-[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
          "then": { "properties": { "failureCodes": { "maxItems": 0 } } },
          "else": { "properties": { "failureCodes": { "minItems": 1 } } }
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "registryId",
        "registryHash",
        "attestationId",
        "verifierNodeId",
        "operatorId",
        "publicKeyFingerprint",
        "verifiedAtLogical",
        "cryptographicSignatureValid",
        "registryStatus",
        "statusEvidenceHash",
        "admitted",
        "identityVerified",
        "approvalAuthority",
        "admissionHash"
      ],
      "properties": {
        "format": { "const": "verification-key-admission" },
        "schemaVersion": { "const": "1.0.0" },
        "registryId": { "type": "string", "pattern": "^key-registry-[a-f0-9]{64}$" },
        "registryHash": { "$ref": "#/$defs/hash" },
        "attestationId": { "type": "string", "pattern": "^attestation-[a-f0-9]{64}$" },
        "verifierNodeId": { "type": "string", "minLength": 1 },
        "operatorId": { "type": "string", "minLength": 1 },
        "publicKeyFingerprint": { "$ref": "#/$defs/hash" },
        "verifiedAtLogical": { "type": "integer", "minimum": 0 },
        "cryptographicSignatureValid": { "const": true },
        "registryStatus": { "enum": ["active", "not-yet-active", "superseded", "revoked", "unknown-key", "identity-mismatch"] },
        "statusEvidenceHash": { "$ref": "#/$defs/hash" },
        "admitted": { "type": "boolean" },
        "identityVerified": { "const": false },
        "approvalAuthority": { "const": "none" },
        "admissionHash": { "$ref": "#/$defs/hash" }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "policy",
        "policyId",
        "artifactType",
        "artifactHash",
        "cryptoProfileId",
        "attestations",
        "passingAttestationCount",
        "failingAttestationCount",
        "distinctPassingOperatorCount",
        "status",
        "independenceBasis",
        "independenceVerified",
        "approvalAuthority",
        "meshHash"
      ],
      "properties": {
        "format": { "const": "verification-mesh" },
        "schemaVersion": { "const": "1.0.0" },
        "policy": { "$ref": "#/$defs/policy" },
        "policyId": { "type": "string", "pattern": "^mesh-policy-[a-f0-9]{64}$" },
        "artifactType": { "type": "string", "minLength": 1 },
        "artifactHash": { "$ref": "#/$defs/hash" },
        "cryptoProfileId": { "$ref": "#/$defs/profileId" },
        "attestations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attestation" } },
        "passingAttestationCount": { "type": "integer", "minimum": 0 },
        "failingAttestationCount": { "type": "integer", "minimum": 0 },
        "distinctPassingOperatorCount": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["quorum-met", "quorum-not-met"] },
        "independenceBasis": { "const": "declared-operator-identity" },
        "independenceVerified": { "const": false },
        "approvalAuthority": { "const": "none" },
        "meshHash": { "$ref": "#/$defs/hash" }
      }
    },
    "admissionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schemaVersion",
        "policyId",
        "registryId",
        "registryHash",
        "cryptoProfileId",
        "admissions",
        "admittedAttestationIds",
        "rejectedAttestationIds",
        "admittedCount",
        "rejectedCount",
        "mesh",
        "status",
        "identityVerified",
        "approvalAuthority",
        "bundleHash"
      ],
      "properties": {
        "format": { "const": "registry-aware-mesh-admission" },
        "schemaVersion": { "const": "1.0.0" },
        "policyId": { "type": "string", "pattern": "^mesh-policy-[a-f0-9]{64}$" },
        "registryId": { "type": "string", "pattern": "^key-registry-[a-f0-9]{64}$" },
        "registryHash": { "$ref": "#/$defs/hash" },
        "cryptoProfileId": { "$ref": "#/$defs/profileId" },
        "admissions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/admission" } },
        "admittedAttestationIds": { "type": "array", "items": { "type": "string", "pattern": "^attestation-[a-f0-9]{64}$" } },
        "rejectedAttestationIds": { "type": "array", "items": { "type": "string", "pattern": "^attestation-[a-f0-9]{64}$" } },
        "admittedCount": { "type": "integer", "minimum": 0 },
        "rejectedCount": { "type": "integer", "minimum": 0 },
        "mesh": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/mesh" }] },
        "status": { "enum": ["quorum-met", "quorum-not-met"] },
        "identityVerified": { "const": false },
        "approvalAuthority": { "const": "none" },
        "bundleHash": { "$ref": "#/$defs/hash" }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactBytesVerified",
        "modelReplayPerformed",
        "realIdentityVerified",
        "organizationalIndependenceVerified",
        "scientificValidityEstablished",
        "externalPublicationVerified",
        "postQuantumSecurityEstablished",
        "zeroKnowledgeProofVerified",
        "approvalAuthority"
      ],
      "properties": {
        "artifactBytesVerified": { "const": "commitment-only" },
        "modelReplayPerformed": { "const": false },
        "realIdentityVerified": { "const": false },
        "organizationalIndependenceVerified": { "const": false },
        "scientificValidityEstablished": { "const": false },
        "externalPublicationVerified": { "const": false },
        "postQuantumSecurityEstablished": { "const": false },
        "zeroKnowledgeProofVerified": { "const": false },
        "approvalAuthority": { "const": "none" }
      }
    }
  }
}
